# py501 · Solo para ejecución local. En Codespaces NO uses este archivo:
# agrega las claves como secretos en github.com/settings/codespaces.
# Copia este archivo a .env (ignorado por git) y completa los valores.
# Tutorial completo: 00_claves_de_api_y_secretos.ipynb
#
# El curso usa Gemini: GOOGLE_API_KEY es obligatoria; las demás son opcionales.

GOOGLE_API_KEY=
LANGSMITH_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=py501

# Modelo y embeddings por defecto (formato "proveedor:modelo")
MODELO=google_genai:gemini-3.5-flash
EMBEDDINGS=google_genai:gemini-embedding-001
